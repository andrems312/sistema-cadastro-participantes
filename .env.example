# =============================================================
#  Sistema de Cadastro de Participantes — variáveis de ambiente
#  Copie para .env.local e preencha. NUNCA versione o .env.local.
# =============================================================

# URL pública da aplicação (usada nos links de e-mail: confirmação e recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública "anon" (ou "publishable"). Segura para o navegador: o acesso é limitado pelas políticas RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave SECRETA "service_role". Usada SOMENTE no servidor (criar/excluir usuários pelo painel do admin).
# Nunca use o prefixo NEXT_PUBLIC_ nesta variável.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mapa (OpenStreetMap) — gratuito, não exige chave ---
# Serviço que converte endereço em latitude/longitude. Padrão: Nominatim público do OpenStreetMap.
GEOCODING_API_URL=https://nominatim.openstreetmap.org
# Opcional: e-mail de contato enviado ao Nominatim (recomendado pela política de uso do OpenStreetMap).
GEOCODING_EMAIL=

# --- APIs públicas (não exigem chave) ---
CNPJ_API_URL=https://brasilapi.com.br/api/cnpj/v1
CEP_API_URL=https://brasilapi.com.br/api/cep/v2
# Limite de consultas de CNPJ por usuário por minuto
CNPJ_RATE_LIMIT_PER_MINUTE=10

# --- Somente desenvolvimento: script de dados de exemplo (npm run seed:dev) ---
# Deixe "false" em produção. O script se recusa a rodar com NODE_ENV=production.
SEED_ALLOW=false
SEED_ADMIN_PASSWORD=
